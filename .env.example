# ─────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 실제 키를 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 로 보호됩니다. 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────

# YouTube Data API v3 키 (번호 순서대로 인식)
#   키 번호 N  ↔  keywords/keywords_N.txt  가 1:1로 짝을 이룹니다.
#   키 하나당 하루 10,000 units 이므로, 키를 늘리면 하루 수집량이 늘어납니다.
#   발급: https://console.cloud.google.com/  →  YouTube Data API v3 사용 설정
YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=

# 숫자가 아닌 접미사를 쓰면 크롤러가 인식하지 않습니다 (예비 키 대기용).
# 실제로 쓸 때 이름을 YOUTUBE_API_KEY_3 처럼 바꾸면 활성화됩니다.
# YOUTUBE_API_KEY_spare=

# OpenAI API 키 (선택)
#   비워두면 AI 정밀 검수 없이 동작합니다. (사용료 발생하지 않음)
#   발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
